# Copy to .env.local and fill in. Never commit .env.local.

# Auth0 "Friendwave Web" application (Regular Web Application), Settings tab
AUTH0_DOMAIN=dev-sg7zftgrqutuvdp3.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Encrypts the session cookie. Generate with: openssl rand -hex 32
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000

# The Friendwave API
AUTH0_AUDIENCE=https://api.friendwave
API_URL=http://localhost:4000
# Used by the browser for the live chat socket
NEXT_PUBLIC_API_URL=http://localhost:4000
